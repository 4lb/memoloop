[Unit]
Description=intervald program-agnostic interval runner
After=graphical-session.target
Wants=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/intervald run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=30
KillMode=process
Environment=XDG_RUNTIME_DIR=%t

[Install]
WantedBy=graphical-session.target