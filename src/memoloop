#!/usr/bin/env bash

SELF_DIR() {
  _sd=${BASH_SOURCE[0]}
  while [ -L "$_sd" ]; do
    _sd_l=$(readlink "$_sd")
    case "$_sd_l" in
    /*) _sd=$_sd_l ;;
    *) _sd=$(dirname -- "$_sd")/$_sd_l ;;
    esac
  done
  (CDPATH='' cd -- "$(dirname -- "$_sd")" && pwd -P)
}
SELF_DIR=$(SELF_DIR)
unset -f SELF_DIR

CONFIG_DIR="${MEMOLOOP_CONFIG_DIR:-$HOME/.config/memoloop}"
DATA_DIR_EXPLICIT="${MEMOLOOP_DATA_DIR:-${USER_DATA_DIR:-}}"
USER_DATA_DIR="${DATA_DIR_EXPLICIT:-${XDG_DATA_HOME:-$HOME/.local/share}/memoloop}"
STATE_DIR="${MEMOLOOP_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/memoloop}"
LOG_DIR="${MEMOLOOP_LOG:-$STATE_DIR/log}"

CONFIG_CONF="$CONFIG_DIR/config.conf"
PICKUP_SET="$CONFIG_DIR/pickup.set"
QUESTIONS_DIR="$USER_DATA_DIR/questions"
ANSWERS_STATE="$USER_DATA_DIR/answers.json"

CURRENT_STATE="$STATE_DIR/current.json"
RESULT_STATE="$STATE_DIR/result.json"
LOG_FILE="$LOG_DIR/reminders.log"

DECAY_HOURS=24
MIN_PER_DAY=10
NOHELP=true

. "$SELF_DIR/../lib/term.sh"

die() {
  printf 'memoloop: %s\n' "$1" >&2

  if [ -t 0 ]; then
    if [ -n "${FOOT_POPUP:-}" ]; then
      printf '\n  Closing in 5s...\n'
      sleep 5
    else
      printf '\n  Press any key to close...\n'
      read -n1 -r -s _dummy || true
    fi
  fi

  exit 1
}
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not installed"; }

nohelp_enabled() {
  case "$1" in
  true | 1 | yes | on) return 0 ;;
  esac
  return 1
}

config_value() {
  _cv=${1%\"}
  _cv=${_cv#\"}
  _cv=${_cv%\'}
  _cv=${_cv#\'}
  case "$_cv" in
  '~/'*) _cv="$HOME/${_cv#\~/}" ;;
  '$HOME/'*) _cv="$HOME/${_cv#\$HOME/}" ;;
  esac
  printf '%s' "$_cv"
}

load_config() {
  local key value
  [ -f "$CONFIG_CONF" ] || return 0
  while IFS='=' read -r key value; do
    key=${key#*[[:space:]]}
    key=${key%[[:space:]]}
    case "$key" in
    USER_DATA_DIR | data_dir)
      [ -z "$DATA_DIR_EXPLICIT" ] || continue
      value=$(config_value "$value")
      [ -n "$value" ] || continue
      USER_DATA_DIR=$value
      QUESTIONS_DIR="$USER_DATA_DIR/questions"
      ANSWERS_STATE="$USER_DATA_DIR/answers.json"
      ;;
    nohelp) [ -n "${MEMOLOOP_NOHELP:-}" ] || NOHELP=$(config_value "$value") ;;
    esac
  done <"$CONFIG_CONF"
}

require_config() {
  [ -f "$PICKUP_SET" ] || die "config not found: $PICKUP_SET"
  local groups
  groups=$(load_enabled_groups)
  [ -n "$groups" ] || die "no enabled question groups in $PICKUP_SET"
  local questions
  questions=$(load_all_questions "$groups")
  local qcount
  qcount=$(printf '%s' "$questions" | jq 'length')
  [ "$qcount" -gt 0 ] || die "no question files found for enabled groups in $QUESTIONS_DIR"
}

epoch() { date +%s; }
iso() { date -d "@$1" '+%H:%M:%S' 2>/dev/null || date -r "$1" '+%H:%M:%S'; }

today_start() {
  date -d "$(date +%F)" +%s 2>/dev/null || date -j -f "%Y-%m-%d" "$(date +%F)" +%s
}

load_intervals() {
  local intervals_conf="$CONFIG_DIR/intervals.conf"
  local legacy_conf="$USER_DATA_DIR/intervals.conf"
  local key value
  [ -f "$intervals_conf" ] || intervals_conf=$legacy_conf
  if [ -f "$intervals_conf" ]; then
    while IFS='=' read -r key value; do
      value=${value%%#*}          # strip inline comment
      value="${value#"${value%%[![:space:]]*}"}"   # trim leading whitespace
      value="${value%"${value##*[![:space:]]}"}"   # trim trailing whitespace
      value=$(config_value "$value")
      case "$key" in
      decay_hours) DECAY_HOURS="$value" ;;
      min_per_day) MIN_PER_DAY="$value" ;;
      nohelp) NOHELP="$value" ;;
      esac
    done <"$intervals_conf"
  fi
  if [ -n "${MEMOLOOP_NOHELP:-}" ]; then
    NOHELP=$MEMOLOOP_NOHELP
  fi
  [ -n "${MEMOLOOP_DECAY_HOURS:-}" ] && DECAY_HOURS=$MEMOLOOP_DECAY_HOURS
  [ -n "${MEMOLOOP_MIN_PER_DAY:-}" ] && MIN_PER_DAY=$MEMOLOOP_MIN_PER_DAY
}

load_enabled_groups() {
  if [ -f "$PICKUP_SET" ]; then
    grep -v '^[[:space:]]*#' "$PICKUP_SET" | grep -v '^[[:space:]]*$'
  fi
}

lock_state() {
  command -v flock >/dev/null 2>&1 || return 0
  exec 9>"$STATE_DIR/.lock" 2>/dev/null || return 0
  flock -w 5 9 || true
}

state_init() {
  mkdir -p "$STATE_DIR" "$LOG_DIR" "$USER_DATA_DIR"
  load_config
  load_intervals

  if [ ! -f "$ANSWERS_STATE" ] || [ ! -s "$ANSWERS_STATE" ]; then
    printf '{}' >"$ANSWERS_STATE"
  fi
  touch "$LOG_FILE"
}

log_add() {
  printf '%s %s %s %s\n' "$(iso "$(epoch)")" "$1" "$2" "$3" >>"$LOG_FILE"
}

load_all_questions() {
  local groups="$1"
  local group file files=()
  for group in $groups; do
    for file in "$QUESTIONS_DIR/$group"/*.json; do
      [ -f "$file" ] || continue
      files+=("$file")
    done
  done
  [ ${#files[@]} -gt 0 ] || {
    printf '[]'
    return 0
  }
  jq -s 'add' "${files[@]}"
}

load_answers() {
  if [ -f "$ANSWERS_STATE" ]; then
    cat "$ANSWERS_STATE"
  else
    printf '{}'
  fi
}

save_answers() {
  mkdir -p "$USER_DATA_DIR"
  (
    lock_state
    printf '%s' "$1" >"$ANSWERS_STATE.tmp" && mv "$ANSWERS_STATE.tmp" "$ANSWERS_STATE"
  )
}

update_points() {
  local qid="$1" result="$2"
  [ "$result" = "accepted" ] || [ "$result" = "rejected" ] || return 0

  local answers now points
  answers=$(load_answers)
  now=$(epoch)
  points=$(printf '%s' "$answers" | jq --arg id "$qid" '.[$id].points // 100')

  case "$result" in
  accepted) points=$((points + 10)) ;;
  rejected)
    points=$((points - 10))
    [ "$points" -lt 0 ] && points=0
    ;;
  esac

  answers=$(printf '%s' "$answers" | jq --arg id "$qid" --arg result "$result" --argjson pts "$points" --argjson now "$now" '
    .[$id] = {
      points: $pts,
      last_shown: $now,
      last_correct: (if $result == "accepted" then $now else .[$id].last_correct end),
      times_shown: ((.[$id].times_shown // 0) + 1),
      times_correct: ((.[$id].times_correct // 0) + (if $result == "accepted" then 1 else 0 end))
    }
  ')
  save_answers "$answers"
}

question_weight() {
  local qid="$1" answers="$2" now="$3"
  local points last_shown hours_diff decay_factor effective_points weight

  points=$(printf '%s' "$answers" | jq --arg id "$qid" '.[$id].points // 100')
  last_shown=$(printf '%s' "$answers" | jq --arg id "$qid" '.[$id].last_shown // 0')

  if [ "$last_shown" = "0" ] || [ "$last_shown" = "null" ]; then
    decay_factor=1
  else
    hours_diff=$(((now - last_shown) / 3600))
    [ "$hours_diff" -lt 0 ] && hours_diff=0
    decay_factor=$(awk -v hd="$hours_diff" -v dh="$DECAY_HOURS" 'BEGIN { print exp(log(0.5) * hd / dh) }')
  fi

  effective_points=$(awk -v p="$points" -v df="$decay_factor" 'BEGIN { print p * df }')
  weight=$(awk -v ep="$effective_points" 'BEGIN { print 100 / (ep + 100) }')
  printf '%s' "$weight"
}

questions_shown_today() {
  local answers count
  answers=$(load_answers)
  count=$(printf '%s' "$answers" | jq --argjson start "$(today_start)" '
    [to_entries[] | select(.value.last_shown >= $start)] | length
  ')
  printf '%s' "$count"
}

select_question() {
  local groups="$1"
  local questions answers now shown_count today chosen seed
  questions=$(load_all_questions "$groups")
  answers=$(load_answers)
  now=$(epoch)
  today=$(today_start)
  shown_count=$(questions_shown_today)

  local qcount
  qcount=$(printf '%s' "$questions" | jq 'length')
  [ "$qcount" -gt 0 ] || return 1

  seed=$(date +%s%N)

  chosen=$(printf '%s' "$questions" | jq -r --argjson answers "$answers" --argjson start "$today" --argjson shown_count "$shown_count" --argjson min_per_day "$MIN_PER_DAY" --argjson now "$now" --argjson decay_hours "$DECAY_HOURS" '
    .[] |
    . as $q |
    $q.id as $id |
    ($answers[$id] // {}) as $a |
    ($a.points // 100) as $points |
    ($a.last_shown // 0) as $last_shown |
    "\($points)\t\($last_shown)\t\($q | @json)"
  ' | awk -v shown_count="$shown_count" -v min_per_day="$MIN_PER_DAY" -v start="$today" -v now="$now" -v decay_hours="$DECAY_HOURS" -v seed="$seed" '
    BEGIN { FS="\t"; srand(seed); n=0 }
    {
      points[n]=$1+0
      last_shown[n]=$2+0
      json[n]=$3
      n++
    }
    END {
      total_weight=0
      for (i=0; i<n; i++) {
        if (shown_count < min_per_day && last_shown[i] >= start) continue
        if (last_shown[i] == 0) decay_factor=1
        else {
          hours_diff=int((now-last_shown[i])/3600)
          if (hours_diff<0) hours_diff=0
          decay_factor=exp(log(0.5)*hours_diff/decay_hours)
        }
        weight[i]=100/(points[i]*decay_factor+100)
        total_weight+=weight[i]
      }
      r=rand()*total_weight
      cumulative=0
      chosen=""
      for (i=0; i<n; i++) {
        if (shown_count < min_per_day && last_shown[i] >= start) continue
        cumulative+=weight[i]
        if (chosen=="" && r<cumulative) chosen=json[i]
      }
      print chosen
    }
  ')

  if [ -z "$chosen" ] || [ "$chosen" = "null" ]; then
    printf '%s' "$questions" | jq '.[0]'
    return 0
  fi
  printf '%s' "$chosen"
}

popup_spawn() {
  local id="$1"
  need foot
  if [ -t 0 ]; then
    FOOT_POPUP=1 setsid --fork foot --app-id="memoloop" -e "$SELF_DIR/memoloop" ask "$id" </dev/null >/dev/null 2>&1
  else
    FOOT_POPUP=1 foot --app-id="memoloop" -e "$SELF_DIR/memoloop" ask "$id" </dev/null &
  fi
}

cmd_ask() {
  term_init
  local id="${1:-manual}"

  if [ -z "${FOOT_POPUP:-}" ]; then
    popup_spawn "$id"
    return 0
  fi

  need jq
  state_init

  while :; do
    ask_question "$id" || return 0
  done
}

ask_question() {
  local id="$1"

  local groups
  groups=$(load_enabled_groups)
  [ -n "$groups" ] || die "no enabled question groups in $PICKUP_SET"

  local json
  json=$(select_question "$groups")
  if [ -z "$json" ] || [ "$json" = "null" ]; then
    die "no question files found for enabled groups in $QUESTIONS_DIR"
  fi

  local qtype jp en target note answer_label choices answer_letter
  qtype=$(printf '%s' "$json" | jq -r '.type // "translation"')
  jp=$(printf '%s' "$json" | jq -r '.japanese')
  en=$(printf '%s' "$json" | jq -r '.english')
  target=$(printf '%s' "$json" | jq -r '.target // ""')
  note=$(printf '%s' "$json" | jq -r '.note // ""')
  printf '%s' "$json" >"$CURRENT_STATE"

  printf '\n'
  term_header "$TERM_NEUTRAL" "Japanese prompt — $id ($qtype)" ""
  printf '\n'

  case "$qtype" in
  translation)
    term_ask_row '' "$jp"
    term_ask_row '' "英語: $en"
    answer_label='日本語: '
    ;;
  reverse)
    term_ask_row '' "英語: $en"
    [ -n "$note" ] && term_ask_row '' "$note"
    answer_label='日本語: '
    ;;
  cloze)
    local cloze_prompt
    cloze_prompt=$(printf '%s' "$jp" | sed "s|$target|___|")
    term_ask_row '' "$cloze_prompt"
    [ -n "$note" ] && term_ask_row '' "$note"
    term_ask_row '' "Meaning: $en"
    answer_label='Fill in the blank: '
    ;;
  choice)
    choices=$(printf '%s' "$json" | jq -r '.choices | join("\n")')
    answer_letter=$(printf '%s' "$json" | jq -r '.answer')
    term_ask_row '' "$jp"
    term_ask_row '' ''
    while IFS= read -r c; do
      [ -n "$c" ] && term_ask_row '' "  $c"
    done <<<"$choices"
    term_ask_row '' ''
    answer_label='Answer (A/B/C): '
    ;;
  *)
    die "unknown question type: $qtype"
    ;;
  esac

  term_ask_row '' ''
  term_ask_row '-' ''
  TERM_ASK_NO_NEWLINE=1 TERM_ASK_INDENT="$TERM_INDENT  " \
    term_ask_row '' "$answer_label"
  unset TERM_ASK_NO_NEWLINE TERM_ASK_INDENT

  local answer=''
  IFS= read -r answer || true

  term_ask_close
  printf '\033[?25l'
  printf '\n'

  local result="dismissed" correct=0 qid
  qid=$(printf '%s' "$json" | jq -r '.id')
  case "$answer" in
  s | S) result="skipped" ;;
  d | D) result="dismissed" ;;
  *)
    correct=1
    if [ "$qtype" = "choice" ]; then
      if [ "$(normalize "$answer")" = "$(normalize "$answer_letter")" ]; then
        correct=0
      fi
    else
      local accepted a
      accepted=$(printf '%s' "$json" | jq -r '.accepted | join("\n")')
      while IFS= read -r a; do
        [ -z "$a" ] && continue
        if [ "$(normalize "$answer")" = "$(normalize "$a")" ]; then
          correct=0
          break
        fi
      done <<<"$accepted"
    fi
    if [ "$correct" -eq 0 ]; then
      result="accepted"
      accepted_display=$(printf '%s' "$json" | jq -r '.accepted | join(" / ")')
      msg="Answer: $accepted_display ($en)"
      local rows=()
      while IFS= read -r line; do
        [ -n "$line" ] && rows+=("$line")
      done < <(wrap_text "$msg" "$TERM_ROW")
      term_rows_box "$TERM_OK" "$TERM_OK" "Accepted" "$TERM_MARK_OK" "${rows[@]}"
    else
      result="rejected"
      accepted_display=$(printf '%s' "$json" | jq -r '.accepted | join(" / ")')
      msg="Intended: $accepted_display ($en)"
      local rows=()
      while IFS= read -r line; do
        [ -n "$line" ] && rows+=("$line")
      done < <(wrap_text "$msg" "$TERM_ROW")
      term_rows_box "$TERM_NEG" "$TERM_NEG" "Not accepted" "$TERM_MARK_NEG" "${rows[@]}"
    fi
    ;;
  esac

  update_points "$qid" "$result"

  cat >"$RESULT_STATE" <<EOF
{"rule": "$id", "result": "$result", "question": $(printf '%s' "$json"), "answered_at": $(epoch)}
EOF
  log_add "$id" "answered" "$result (answer: $answer, qid: $qid)"

  if [ -t 0 ]; then
    if ! nohelp_enabled "$NOHELP"; then
      printf '\n  n / space / enter = new question, any other key = close\n'
    fi
    _close_key=''
    IFS= read -n1 -r -s _close_key || true
    case "$_close_key" in
    n | N | ' ' | '')
      printf '\033[2J\033[H'
      return 0
      ;;
    esac
  fi

  printf '\033[?25h'
  return 1
}

normalize() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | tr -d '[:space:]'
}

wrap_text() {
  local text="$1" max="$2"
  local word line=""
  for word in $text; do
    if [ -z "$line" ]; then
      line="$word"
    elif [ $((${#line} + 1 + ${#word})) -le "$max" ]; then
      line="$line $word"
    else
      printf '%s\n' "$line"
      line="$word"
    fi
  done
  [ -n "$line" ] && printf '%s\n' "$line"
}

cmd_config() {
  state_init
  require_config
  term_init
  printf '\nMemoLoop configuration:\n\n'
  printf 'Directories:\n'
  printf '  CONFIG_DIR: %s\n' "$CONFIG_DIR"
  printf '  USER_DATA_DIR: %s\n' "$USER_DATA_DIR"
  printf '  QUESTIONS_DIR: %s\n' "$QUESTIONS_DIR"
  printf '  STATE_DIR: %s\n' "$STATE_DIR"
  printf '  LOG_DIR: %s\n' "$LOG_DIR"
  printf '\nSettings:\n'
  printf '  decay_hours: %s\n' "$DECAY_HOURS"
  printf '  min_per_day: %s\n' "$MIN_PER_DAY"
  printf '  nohelp: %s\n' "$NOHELP"
  printf '\nEnabled groups (%s):\n' "$(load_enabled_groups | wc -l)"
  printf '\nInterval file: %s\n' "$CONFIG_DIR/intervals.conf"
  printf 'Config file:   %s\n' "$CONFIG_CONF"
  if [ -f "$CONFIG_CONF" ]; then
    printf '  (loaded from config.conf)\n'
  fi
  printf 'Pickup set: %s\n' "$PICKUP_SET"
  if [ -f "$PICKUP_SET" ]; then
    cat "$PICKUP_SET"
  fi
  printf '\nQuestions available:\n'
  local groups group qcount file
  groups=$(load_enabled_groups)
  if [ -n "$groups" ]; then
    for group in $groups; do
      qcount=0
      for file in "$QUESTIONS_DIR/$group"/*.json; do
        [ -f "$file" ] && qcount=$((qcount + 1))
      done
      printf '  %s: %d question(s)\n' "$group" "$qcount"
    done
  else
    printf '  (no enabled groups)\n'
  fi
  printf '\n'
}

cmd_setup() {
  state_init
  term_init
  term_status "Setup complete" \
    "$TERM_MARK_OK" "state, log, data and config are initialised" \
    "$TERM_MARK_PLAIN" "state: $STATE_DIR" \
    "$TERM_MARK_PLAIN" "log:   $LOG_FILE" \
    "$TERM_MARK_PLAIN" "data:  $USER_DATA_DIR" \
    "$TERM_MARK_PLAIN" "config: $CONFIG_DIR"
}

cmd_test() {
  state_init
  require_config
  local groups
  groups=$(load_enabled_groups)
  [ -n "$groups" ] || die "no enabled question groups in $PICKUP_SET"
  local json
  json=$(select_question "$groups")
  if [ -z "$json" ] || [ "$json" = "null" ]; then
    die "no question files found for enabled groups in $QUESTIONS_DIR"
  fi
  cmd_ask "$(printf '%s' "$json" | jq -r '.id')"
}

usage() {
  cat <<'EOF'
Usage: memoloop <command>

  setup       initialize state, log, data and config directories
  ask [name]  show one question popup (default name: manual)
  test        launch a test prompt immediately
  config      show effective configuration

Config:  ~/.config/memoloop/       (config.conf, intervals.conf, pickup.set)
Data:    ~/.local/share/memoloop/  (questions/, answers.json)
State:   ~/.local/state/memoloop/  (current.json, result.json, log/reminders.log)

Scheduling is handled by intervald; configure its jobs in
~/.config/intervald/config.yaml.
EOF
}

main() {
  case "${1:-}" in
  ask)
    shift
    cmd_ask "$@"
    ;;
  config) cmd_config ;;
  test) cmd_test ;;
  setup) cmd_setup ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
  esac
}

load_config
load_intervals
[ -n "${MEMOLOOP_NOHELP:-}" ] && NOHELP=$MEMOLOOP_NOHELP

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
