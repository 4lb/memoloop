#!/usr/bin/env bash
# memoloop — MemoLoop Linux prototype: independent Japanese study reminders.
#
# Popup-terminal question experience with two scheduling rules:
#   fixed  → one prompt every N seconds (from intervals.conf)
#   random → one prompt at a random interval of M–N minutes
#
# Each rule keeps its own next-due time. Prompts open one at a time in a
# terminal popup; a rule that fires while a prompt is open is queued.
# Global pause / Do-Not-Disturb suppress prompts without backlog.
#
# Configuration: ~/.config/memoloop/  (intervals.conf, pickup.set, questions/)
# Cache/scores:  ~/.cache/memoloop/   (answers.json with point system)
#
# State/ and log/ live beside this script (gitignored).

SELF_DIR() {
  _sd=${BASH_SOURCE[0]}
  while [ -L "$_sd" ]; do
    _sd_l=$(readlink "$_sd")
    case "$_sd_l" in
      /*) _sd=$_sd_l ;;
      *) _sd=$(dirname -- "$_sd")/$_sd_l ;;
    esac
  done
  (CDPATH='' cd -- "$(dirname -- "$_sd")" && pwd -P)
}
SELF_DIR=$(SELF_DIR)
unset -f SELF_DIR

# ------------------------------------------------------------------ paths

CONFIG_DIR="${MEMOLOOP_CONFIG_DIR:-$HOME/.config/memoloop}"
CACHE_DIR="${MEMOLOOP_CACHE_DIR:-$HOME/.cache/memoloop}"
STATE_DIR="${MEMOLOOP_STATE:-$SELF_DIR/../state}"
LOG_DIR="${MEMOLOOP_LOG:-$SELF_DIR/../log}"

INTERVALS_CONF="$CONFIG_DIR/intervals.conf"
PICKUP_SET="$CONFIG_DIR/pickup.set"
QUESTIONS_DIR="$CONFIG_DIR/questions"
ANSWERS_STATE="$CACHE_DIR/answers.json"

RULES_STATE="$STATE_DIR/rules.json"
SESSION_STATE="$STATE_DIR/session.json"
CURRENT_STATE="$STATE_DIR/current.json"
RESULT_STATE="$STATE_DIR/result.json"
LOG_FILE="$LOG_DIR/reminders.log"

# ------------------------------------------------------------------ defaults (overridden by intervals.conf)

FIXED_SECONDS=2700
RANDOM_MIN=15
RANDOM_MAX=30
DECAY_HOURS=24
MIN_PER_DAY=10

RULE_FIXED_ID="fixed"
RULE_RANDOM_ID="random"

# shellcheck source=../lib/term.sh
. "$SELF_DIR/../lib/term.sh"

die() { printf 'memoloop: %s\n' "$1" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not installed"; }

epoch() { date +%s; }
iso() { date -d "@$1" '+%H:%M:%S' 2>/dev/null || date -r "$1" '+%H:%M:%S'; }

today_start() { # → epoch of today 00:00:00
  date -d "$(date +%F)" +%s 2>/dev/null || date -j -f "%Y-%m-%d" "$(date +%F)" +%s
}

# ------------------------------------------------------------------ config

load_intervals() {
  if [ -f "$INTERVALS_CONF" ]; then
    local key value
    while IFS='=' read -r key value; do
      case "$key" in
        fixed_seconds) FIXED_SECONDS="$value" ;;
        random_min) RANDOM_MIN="$value" ;;
        random_max) RANDOM_MAX="$value" ;;
        decay_hours) DECAY_HOURS="$value" ;;
        min_per_day) MIN_PER_DAY="$value" ;;
      esac
    done <"$INTERVALS_CONF"
  fi
}

load_enabled_groups() { # → prints group ids, one per line
  if [ -f "$PICKUP_SET" ]; then
    grep -v '^[[:space:]]*#' "$PICKUP_SET" | grep -v '^[[:space:]]*$'
  fi
}

# ------------------------------------------------------------------ state

state_init() {
  mkdir -p "$STATE_DIR" "$LOG_DIR" "$CACHE_DIR"
  load_intervals

  if [ ! -f "$RULES_STATE" ]; then
    cat >"$RULES_STATE" <<EOF
{
  "rules": [
    {"id": "fixed", "type": "fixed", "seconds": $FIXED_SECONDS, "enabled": true, "next_due": 0},
    {"id": "random", "type": "random", "min": $RANDOM_MIN, "max": $RANDOM_MAX, "enabled": true, "next_due": 0}
  ]
}
EOF
  fi
  if [ ! -f "$SESSION_STATE" ]; then
    cat >"$SESSION_STATE" <<EOF
{"paused": false, "dnd_start": null, "dnd_end": null, "open": 0, "queue": []}
EOF
  fi
  if [ ! -f "$ANSWERS_STATE" ] || [ ! -s "$ANSWERS_STATE" ]; then
    printf '{}' >"$ANSWERS_STATE"
  fi
  touch "$LOG_FILE"
}

rules_get() { # $1 = rule id
  jq -r --arg id "$1" '.rules[] | select(.id==$id)' "$RULES_STATE"
}

rules_set_next_due() { # $1 = rule id $2 = next_due epoch
  jq --arg id "$1" --argjson nd "$2" '
    (.rules[] | select(.id==$id)).next_due = $nd
  ' "$RULES_STATE" >"$RULES_STATE.tmp" && mv "$RULES_STATE.tmp" "$RULES_STATE"
}

rules_set_enabled() { # $1 = rule id $2 = true|false
  jq --arg id "$1" --argjson en "$2" '
    (.rules[] | select(.id==$id)).enabled = $en
  ' "$RULES_STATE" >"$RULES_STATE.tmp" && mv "$RULES_STATE.tmp" "$RULES_STATE"
}

rule_next_due() { # $1 = rule id → prints epoch
  jq -r --arg id "$1" '.rules[] | select(.id==$id).next_due' "$RULES_STATE"
}

rule_enabled() { # $1 = rule id → prints true|false
  jq -r --arg id "$1" '.rules[] | select(.id==$id).enabled' "$RULES_STATE"
}

session_get() { # $1 = key
  jq -r --arg k "$1" '.[$k]' "$SESSION_STATE"
}

session_set() { # $1 = key $2 = value (json)
  jq --arg k "$1" --argjson v "$2" '. + {($k): $v}' "$SESSION_STATE" >"$SESSION_STATE.tmp" && mv "$SESSION_STATE.tmp" "$SESSION_STATE"
}

session_queue_push() { # $1 = rule id
  local q
  q=$(jq -r '.queue[]' "$SESSION_STATE" 2>/dev/null | grep -xF "$1" || true)
  if [ -z "$q" ]; then
    jq --arg id "$1" '.queue += [$id] | .open = 1' "$SESSION_STATE" >"$SESSION_STATE.tmp" && mv "$SESSION_STATE.tmp" "$SESSION_STATE"
  fi
}

session_queue_pop() { # → prints rule id or empty
  local id
  id=$(jq -r '.queue[0] // empty' "$SESSION_STATE")
  if [ -n "$id" ]; then
    jq 'del(.queue[0])' "$SESSION_STATE" >"$SESSION_STATE.tmp" && mv "$SESSION_STATE.tmp" "$SESSION_STATE"
  fi
  printf '%s' "$id"
}

session_open_set() { # $1 = 0|1
  jq --argjson o "$1" '.open = $o' "$SESSION_STATE" >"$SESSION_STATE.tmp" && mv "$SESSION_STATE.tmp" "$SESSION_STATE"
}

log_add() { # $1 = rule $2 = event $3 = message
  printf '%s %s %s %s\n' "$(iso "$(epoch)")" "$1" "$2" "$3" >>"$LOG_FILE"
}

# ------------------------------------------------------------------ questions

load_all_questions() { # $1 = newline-separated group ids → prints combined JSON array
  local groups="$1"
  local combined="[]"
  local group file
  for group in $groups; do
    for file in "$QUESTIONS_DIR/$group"/*.json; do
      [ -f "$file" ] || continue
      combined=$(jq -s '.[0] + .[1]' <(printf '%s' "$combined") "$file")
    done
  done
  printf '%s' "$combined"
}

# ------------------------------------------------------------------ answers / scoring

load_answers() { # → prints answers JSON object
  if [ -f "$ANSWERS_STATE" ]; then
    cat "$ANSWERS_STATE"
  else
    printf '{}'
  fi
}

save_answers() { # $1 = answers JSON
  mkdir -p "$CACHE_DIR"
  printf '%s' "$1" >"$ANSWERS_STATE"
}

update_points() { # $1 = question id $2 = result (accepted|rejected|dismissed|skipped|paused)
  local qid="$1" result="$2"
  [ "$result" = "accepted" ] || [ "$result" = "rejected" ] || return 0

  local answers now points
  answers=$(load_answers)
  now=$(epoch)
  points=$(printf '%s' "$answers" | jq --arg id "$qid" '.[$id].points // 100')

  case "$result" in
    accepted) points=$(( points + 10 )) ;;
    rejected) points=$(( points - 10 )); [ "$points" -lt 0 ] && points=0 ;;
  esac

  answers=$(printf '%s' "$answers" | jq --arg id "$qid" --arg result "$result" --argjson pts "$points" --argjson now "$now" '
    .[$id] = {
      points: $pts,
      last_shown: $now,
      last_correct: (if $result == "accepted" then $now else .[$id].last_correct end),
      times_shown: ((.[$id].times_shown // 0) + 1),
      times_correct: ((.[$id].times_correct // 0) + (if $result == "accepted" then 1 else 0 end))
    }
  ')
  save_answers "$answers"
}

question_weight() { # $1 = question id $2 = answers JSON $3 = now epoch → prints weight
  local qid="$1" answers="$2" now="$3"
  local points last_shown hours_diff decay_factor effective_points weight

  points=$(printf '%s' "$answers" | jq --arg id "$qid" '.[$id].points // 100')
  last_shown=$(printf '%s' "$answers" | jq --arg id "$qid" '.[$id].last_shown // 0')

  if [ "$last_shown" = "0" ] || [ "$last_shown" = "null" ]; then
    decay_factor=1
  else
    hours_diff=$(( (now - last_shown) / 3600 ))
    decay_factor=$(awk -v hd="$hours_diff" -v dh="$DECAY_HOURS" 'BEGIN { print exp(log(0.5) * hd / dh) }')
  fi

  effective_points=$(awk -v p="$points" -v df="$decay_factor" 'BEGIN { print p * df }')
  weight=$(awk -v ep="$effective_points" 'BEGIN { print 100 / (ep + 100) }')
  printf '%s' "$weight"
}

questions_shown_today() { # → count of unique question IDs shown today
  local answers count
  answers=$(load_answers)
  count=$(printf '%s' "$answers" | jq --argjson start "$(today_start)" '
    [to_entries[] | select(.value.last_shown >= $start)] | length
  ')
  printf '%s' "$count"
}

select_question() { # $1 = newline-separated group ids → prints selected question JSON
  local groups="$1"
  local questions answers now shown_count
  questions=$(load_all_questions "$groups")
  answers=$(load_answers)
  now=$(epoch)
  shown_count=$(questions_shown_today)

  local qcount
  qcount=$(printf '%s' "$questions" | jq 'length')
  [ "$qcount" -gt 0 ] || return 1

  # Build arrays of question IDs and weights
  local qids=() weights=()
  local total_weight=0
  local all_ids qid w

  all_ids=$(printf '%s' "$questions" | jq -r '.[].id')
  for qid in $all_ids; do
    # Daily minimum: skip questions already shown today
    if [ "$shown_count" -lt "$MIN_PER_DAY" ]; then
      local was_shown
      was_shown=$(printf '%s' "$answers" | jq --arg id "$qid" --argjson start "$(today_start)" '
        (.[$id].last_shown // 0) >= $start
      ')
      [ "$was_shown" = "true" ] && continue
    fi

    w=$(question_weight "$qid" "$answers" "$now")
    qids+=("$qid")
    weights+=("$w")
    total_weight=$(awk -v tw="$total_weight" -v w="$w" 'BEGIN { print tw + w }')
  done

  [ ${#qids[@]} -gt 0 ] || return 1

  # Weighted random selection
  local r cumulative idx now
  now=$(epoch)
  r=$(awk -v tw="$total_weight" -v seed="$now" 'BEGIN { srand(seed); print rand() * tw }')
  cumulative=0
  idx=0
  for qid in "${qids[@]}"; do
    cumulative=$(awk -v c="$cumulative" -v w="${weights[$idx]}" 'BEGIN { print c + w }')
    if [ "$(awk -v r="$r" -v c="$cumulative" 'BEGIN { print (r < c) ? 1 : 0 }')" = "1" ]; then
      printf '%s' "$questions" | jq --arg id "$qid" '.[] | select(.id == $id)'
      return 0
    fi
    idx=$((idx + 1))
  done

  # Fallback: return first
  printf '%s' "$questions" | jq '.[0]'
}

# ------------------------------------------------------------------ scheduling

random_between() { # $1 min $2 max
  local min="$1" max="$2"
  printf '%d' "$(( min + RANDOM % (max - min + 1) ))"
}

rule_interval_seconds() { # $1 = rule id → prints seconds
  local r type min max
  r=$(rules_get "$1")
  type=$(printf '%s' "$r" | jq -r '.type')
  case "$type" in
    fixed)
      printf '%d' "$FIXED_SECONDS"
      ;;
    random)
      min=$(printf '%s' "$r" | jq -r '.min')
      max=$(printf '%s' "$r" | jq -r '.max')
      printf '%d' "$(( $(random_between "$min" "$max") * 60 ))"
      ;;
    *) die "unknown schedule type for rule $1: $type" ;;
  esac
}

schedule_recalc() { # $1 = rule id → sets next_due = now + interval
  local id="$1" now sec
  now=$(epoch)
  sec=$(rule_interval_seconds "$id")
  rules_set_next_due "$id" "$(( now + sec ))"
}

in_dnd() { # → 0 if in DND window, 1 otherwise
  local start end now_hm
  start=$(session_get dnd_start)
  end=$(session_get dnd_end)
  [ "$start" = "null" ] || [ -z "$start" ] && return 1
  [ "$end" = "null" ] || [ -z "$end" ] && return 1
  now_hm=$(date +%H:%M)
  if [ "$now_hm" \> "$start" ] && [ "$now_hm" \< "$end" ]; then
    return 0
  fi
  [ "$now_hm" = "$start" ] && return 0
  [ "$now_hm" = "$end" ] && return 0
  return 1
}

due_rules() { # → prints rule ids due now (enabled, past next_due)
  local now id r enabled nd
  now=$(epoch)
  for id in fixed random; do
    [ "$(rule_enabled "$id")" = "true" ] || continue
    nd=$(rule_next_due "$id")
    [ "$nd" = "null" ] || [ -z "$nd" ] || [ "$nd" = "0" ] && continue
    [ "$now" -ge "$nd" ] || continue
    printf '%s\n' "$id"
  done
}

# ------------------------------------------------------------------ popup

popup_running() { # → 0 if a popup process is still alive
  local pid
  pid=$(session_get open_pid 2>/dev/null || true)
  [ -n "$pid" ] && [ "$pid" != "null" ] && kill -0 "$pid" 2>/dev/null
}

launch_popup() { # $1 = rule id
  local id="$1"
  need foot
  foot --app-id="memoloop" -e "$SELF_DIR/memoloop" ask "$id" &
  local pid=$!
  session_set open_pid "$pid"
  session_open_set 1
  log_add "$id" "fired" "popup launched (pid $pid)"
}

process_queue() { # → if no popup open, launch next queued rule
  if popup_running; then return 0; fi
  session_open_set 0
  session_set open_pid "null"
  local id
  id=$(session_queue_pop)
  if [ -n "$id" ] && [ "$id" != "null" ]; then
    launch_popup "$id"
  fi
}

# ------------------------------------------------------------------ ask

cmd_ask() { # $1 = rule id (optional; defaults to "manual")
  term_init
  local id="${1:-manual}"
  need jq

  local groups json qtype jp en target note answer_label choices answer_letter
  groups=$(load_enabled_groups)
  [ -n "$groups" ] || die "no enabled question groups in $PICKUP_SET"

  json=$(select_question "$groups")
  [ -n "$json" ] && [ "$json" != "null" ] || die "no questions available in enabled groups"

  qtype=$(printf '%s' "$json" | jq -r '.type // "translation"')
  jp=$(printf '%s' "$json" | jq -r '.japanese')
  en=$(printf '%s' "$json" | jq -r '.english')
  target=$(printf '%s' "$json" | jq -r '.target // ""')
  note=$(printf '%s' "$json" | jq -r '.note // ""')
  printf '%s' "$json" >"$CURRENT_STATE"

  printf '\n'
  term_header "$TERM_NEUTRAL" "Japanese prompt — $id ($qtype)" ""
  printf '\n'

  case "$qtype" in
    translation)
      term_ask_row '' "$jp"
      term_ask_row '' "English: $en"
      answer_label='Japanese: '
      ;;
    reverse)
      term_ask_row '' "English: $en"
      [ -n "$note" ] && term_ask_row '' "$note"
      answer_label='Japanese: '
      ;;
    cloze)
      local cloze_prompt
      cloze_prompt=$(printf '%s' "$jp" | sed "s|$target|___|")
      term_ask_row '' "$cloze_prompt"
      [ -n "$note" ] && term_ask_row '' "$note"
      term_ask_row '' "Meaning: $en"
      answer_label='Fill in the blank: '
      ;;
    choice)
      choices=$(printf '%s' "$json" | jq -r '.choices | join("\n")')
      answer_letter=$(printf '%s' "$json" | jq -r '.answer')
      term_ask_row '' "$jp"
      term_ask_row '' ''
      while IFS= read -r c; do
        [ -n "$c" ] && term_ask_row '' "  $c"
      done <<<"$choices"
      term_ask_row '' ''
      answer_label='Answer (A/B/C): '
      ;;
    *)
      die "unknown question type: $qtype"
      ;;
  esac

  term_ask_row '' ''
  term_ask_row '-' ''
  TERM_ASK_NO_NEWLINE=1 TERM_ASK_INDENT="$TERM_INDENT  " \
    term_ask_row '' "$answer_label"
  unset TERM_ASK_NO_NEWLINE TERM_ASK_INDENT

  local answer=''
  IFS= read -r answer || true

  term_ask_close
  # Hide cursor while the feedback box is shown
  printf '\033[?25l'
  printf '\n'

  local result="dismissed" correct=0 qid
  qid=$(printf '%s' "$json" | jq -r '.id')
  case "$answer" in
    ''|s|S) result="skipped" ;;
    p|P)
      session_set paused true
      result="paused"
      term_notice "Paused" "All reminders paused. Run 'memoloop resume' to continue."
      ;;
    d|D) result="dismissed" ;;
    *)
      correct=1
      if [ "$qtype" = "choice" ]; then
        if [ "$(normalize "$answer")" = "$(normalize "$answer_letter")" ]; then
          correct=0
        fi
      else
        local accepted a
        accepted=$(printf '%s' "$json" | jq -r '.accepted | join("\n")')
        while IFS= read -r a; do
          [ -z "$a" ] && continue
          if [ "$(normalize "$answer")" = "$(normalize "$a")" ]; then correct=0; break; fi
        done <<<"$accepted"
      fi
  if [ "$correct" -eq 0 ]; then
    result="accepted"
    accepted_display=$(printf '%s' "$json" | jq -r '.accepted | join(" / ")')
    msg="Answer: $accepted_display ($en)"
    local rows=()
    while IFS= read -r line; do
      [ -n "$line" ] && rows+=("$line")
    done < <(wrap_text "$msg" "$TERM_ROW")
    term_rows_box "$TERM_OK" "$TERM_OK" "Accepted" "$TERM_MARK_OK" "${rows[@]}"
  else
    result="rejected"
    accepted_display=$(printf '%s' "$json" | jq -r '.accepted | join(" / ")')
    msg="Intended: $accepted_display ($en)"
    local rows=()
    while IFS= read -r line; do
      [ -n "$line" ] && rows+=("$line")
    done < <(wrap_text "$msg" "$TERM_ROW")
    term_rows_box "$TERM_NEG" "$TERM_NEG" "Not accepted" "$TERM_MARK_NEG" "${rows[@]}"
  fi
      ;;
  esac

  # Keep the window open so the reader can review the feedback, then close on
  # any key (no Enter required). Skipped when stdin is not a terminal.
  if [ -t 0 ]; then
    printf '\n  Press any key to close...\n'
    _close_key=''
    read -n1 -r -s _close_key || true
  fi

  # Update answer cache with points
  update_points "$qid" "$result"

  cat >"$RESULT_STATE" <<EOF
{"rule": "$id", "result": "$result", "question": $(printf '%s' "$json"), "answered_at": $(epoch)}
EOF
  log_add "$id" "answered" "$result (answer: $answer, qid: $qid)"
  # Restore cursor before exiting
  printf '\033[?25h'
  return 0
}

normalize() { # $1 = text → lowercase, trimmed, spaces removed
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | tr -d '[:space:]'
}

# Wrap text into lines of at most $2 chars, one per line, splitting on spaces.
wrap_text() { # $1 text $2 max width
  local text="$1" max="$2"
  local word line=""
  # shellcheck disable=SC2086
  for word in $text; do
    if [ -z "$line" ]; then
      line="$word"
    elif [ $(( ${#line} + 1 + ${#word} )) -le "$max" ]; then
      line="$line $word"
    else
      printf '%s\n' "$line"
      line="$word"
    fi
  done
  [ -n "$line" ] && printf '%s\n' "$line"
}

# ------------------------------------------------------------------ watch / start / stop

PID_FILE="$STATE_DIR/pidfile"

cmd_watch() { # foreground daemon loop (used internally by start)
  state_init
  need foot jq
  # Seed next_due on first start (consistent restart behaviour: recalculate from now).
  for id in fixed random; do
    [ "$(rule_next_due "$id")" = "0" ] && schedule_recalc "$id"
  done

  term_notice "memoloop watch" "Watching rules: fixed ${FIXED_SECONDS}s · random ${RANDOM_MIN}–${RANDOM_MAX}min"

  while :; do
    process_queue
    if [ "$(session_get paused)" = "true" ] || in_dnd; then
      sleep 5
      continue
    fi
    local id
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      if popup_running; then
        session_queue_push "$id"
        log_add "$id" "queued" "prompt already open"
      else
        launch_popup "$id"
      fi
      schedule_recalc "$id"
    done < <(due_rules)
    sleep 5
  done
}

cmd_start() { # background the daemon and return immediately
  state_init
  need foot jq
  # Seed next_due on first start.
  for id in fixed random; do
    [ "$(rule_next_due "$id")" = "0" ] && schedule_recalc "$id"
  done

  # If already running, don't start a second instance.
  if [ -f "$PID_FILE" ]; then
    local old_pid
    old_pid=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
      term_notice "memoloop already running" "PID $old_pid"
      return 0
    fi
  fi

  # Launch watch in a new session so it survives terminal close.
  # The child writes its own PID to the pidfile before exec'ing into watch,
  # so we always capture the correct daemon PID.
  rm -f "$PID_FILE"
  setsid bash -c "printf '%s' \$\$ > '$PID_FILE'; exec '$SELF_DIR/memoloop' watch" >>"$LOG_FILE" 2>&1 &
  local setsid_pid=$!

  # Wait briefly for the daemon to write its pidfile
  local waited=0
  while [ ! -s "$PID_FILE" ] && [ "$waited" -lt 10 ]; do
    sleep 0.1
    waited=$((waited + 1))
  done

  # Show status after starting
  local watch_pid paused dnd nd_fixed nd_random st
  watch_pid=$(cat "$PID_FILE" 2>/dev/null)
  paused=$(session_get paused)
  dnd=$(in_dnd && echo yes || echo no)
  nd_fixed=$(rule_next_due fixed)
  nd_random=$(rule_next_due random)
  if [ "$paused" = "true" ]; then
    st="PAUSED"
  elif [ "$dnd" = "yes" ]; then
    st="Do Not Disturb"
  else
    st="reminders running"
  fi

  printf '\n'
  printf '%s%s%s%s%s\n' "$TERM_ADD" "$TERM_FRAME_TOP_LEFT" \
    "$(term_rep "$TERM_FRAME_HORIZONTAL" $((TERM_WIDTH - TERM_RULE)))" \
    "$TERM_FRAME_TOP_RIGHT" "$TERM_RESET"
  printf '\n'
  term_ask_row "$TERM_MARK_ADD" "memoloop started · PID $watch_pid"
  term_ask_row "$TERM_MARK_PLAIN" "next: fixed $(iso "$nd_fixed") | random $(iso "$nd_random")"
  printf '\n'
  printf '%s%s%s%s%s\n' "$TERM_ADD" "$TERM_FRAME_BOTTOM_LEFT" \
    "$(term_rep "$TERM_FRAME_HORIZONTAL" $((TERM_WIDTH - TERM_RULE)))" \
    "$TERM_FRAME_BOTTOM_RIGHT" "$TERM_RESET"
  printf '\n'
}

cmd_stop() { # stop the background daemon
  state_init
  if [ ! -f "$PID_FILE" ]; then
    term_notice "memoloop not running" "No pidfile at $PID_FILE"
    return 0
  fi
  local pid
  pid=$(cat "$PID_FILE" 2>/dev/null)
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$PID_FILE"
    term_notice "memoloop not running" "Stale pidfile removed"
    return 0
  fi
  kill "$pid" 2>/dev/null
  # Wait briefly for it to exit
  local waited=0
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 10 ]; do
    sleep 0.5
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
  fi
  rm -f "$PID_FILE"
  term_removed "memoloop stopped · PID $pid"
}

cmd_status() {
  state_init
  term_init
  local paused dnd nd_fixed nd_random status daemon_status
  paused=$(session_get paused)
  dnd=$(in_dnd && echo yes || echo no)
  nd_fixed=$(rule_next_due fixed)
  nd_random=$(rule_next_due random)

  # Check if the daemon process is actually alive
  daemon_status="stopped"
  if [ -f "$PID_FILE" ]; then
    local dp
    dp=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$dp" ] && kill -0 "$dp" 2>/dev/null; then
      daemon_status="running"
    fi
  fi

  # Daemon state drives the top-level status
  if [ "$daemon_status" = "stopped" ]; then
    status_marker="$TERM_MARK_PLAIN"
    status_text="memoloop is not running"
  elif [ "$paused" = "true" ]; then
    status_marker="$TERM_MARK_NEG"
    status_text="memoloop is paused"
  elif [ "$dnd" = "yes" ]; then
    status_marker="$TERM_MARK_WARN"
    status_text="memoloop is in do not disturb"
  else
    status_marker="$TERM_MARK_OK"
    status_text="memoloop is running"
  fi

  local status_args
  status_args=("$status_marker" "$status_text")
  if [ "$daemon_status" = "running" ]; then
    status_args+=("$TERM_MARK_PLAIN" "next: fixed $(iso "$nd_fixed") | random $(iso "$nd_random")")
  fi

  term_status "Status" "${status_args[@]}"
}

cmd_pause() { session_set paused true; term_notice "Paused" "All reminders paused."; }
cmd_resume() { session_set paused false; term_notice "Resumed" "Reminders running again."; }

cmd_dnd() { # $1 = start HH:MM $2 = end HH:MM
  local start="${1:-}" end="${2:-}"
  [ -n "$start" ] && [ -n "$end" ] || die "usage: memoloop dnd <start HH:MM> <end HH:MM>"
  session_set dnd_start "\"$start\""
  session_set dnd_end "\"$end\""
  term_notice "Do Not Disturb" "DND window $start – $end"
}

cmd_test() {
  state_init
  term_init
  need foot jq
  launch_popup fixed
  term_notice "Test" "Fixed-rule prompt launched. Watch the popup terminal."
}

# ---------------------------------------------------------------- setup

cmd_setup() {
  state_init
  term_notice "Setup" "Config: $CONFIG_DIR  Cache: $CACHE_DIR"
}

# ---------------------------------------------------------------- config management

cmd_config() { # show effective config
  state_init
  term_init
  printf '\n'
  term_header "$TERM_NEUTRAL" "memoloop config" ""
  printf '\n'
  term_ask_row '' "CONFIG_DIR=$CONFIG_DIR"
  term_ask_row '' "CACHE_DIR=$CACHE_DIR"
  term_ask_row '' "fixed_seconds=$FIXED_SECONDS"
  term_ask_row '' "random_min=$RANDOM_MIN random_max=$RANDOM_MAX"
  term_ask_row '' "decay_hours=$DECAY_HOURS min_per_day=$MIN_PER_DAY"
  term_ask_row '' ''
  term_ask_row '-' ''
  local groups
  groups=$(load_enabled_groups)
  term_ask_row '' "Enabled groups:"
  for g in $groups; do
    term_ask_row '' "  $g"
  done
  term_ask_close
  printf '\n'
}

# ---------------------------------------------------------------- main

usage() {
  cat <<'EOF'
Usage: memoloop <command>

  setup       initialize state/cache/config directories
  start       start the reminder daemon in the background
  stop        stop the background reminder daemon
  ask <rule>  show one question popup (used by the daemon)
  status      show paused/DND/next-due/state
  config      show effective configuration
  pause       pause all reminders
  resume      resume all reminders
  dnd  <e> set Do Not Disturb window (HH:MM HH:MM)
  test        launch a test prompt immediately

Config:  ~/.config/memoloop/  (intervals.conf, pickup.set, questions/)
Cache:   ~/.cache/memoloop/   (answers.json with point system)
EOF
}

main() {
  case "${1:-}" in
    start)    shift; cmd_start "$@" ;;
    stop)     shift; cmd_stop "$@" ;;
    watch)    cmd_watch ;;       # internal foreground loop, used by start
    ask)      shift; cmd_ask "$@" ;;
    status)   cmd_status ;;
    config)   cmd_config ;;
    pause)    cmd_pause ;;
    resume)   cmd_resume ;;
    dnd)      shift; cmd_dnd "$@" ;;
    test)     cmd_test ;;
    setup)    cmd_setup ;;
    -h|--help|help) usage ;;
    *)        usage >&2; exit 1 ;;
  esac
}

# Only run the command dispatcher when executed directly, not when sourced
# (e.g. by the test suite, which calls the functions directly).
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
